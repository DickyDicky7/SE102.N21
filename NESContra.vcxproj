  <!-- Copy runtime resources (and the shader sources, for the runtime
       fallback) to the output directory so the game can be launched from
       $(OutDir) without a separate working directory.

       Custom targets belong after the Microsoft.Cpp.targets import, so that
       AfterTargets can name a target the import has already defined.

       The shader copy uses the Copy task rather than another Exec: $(OutDir)
       ends in a backslash, so `copy /y "src" "$(OutDir)"` expanded to an
       argument ending in \" - which cmd's own builtin tolerates, but which any
       other tool would read as an escaped quote and mis-parse. The Copy task
       takes the path as a real value instead of pasting it into a command line,
       and SkipUnchangedFiles gives the /d behaviour the xcopy above has. -->
  <Target Name="CopyRuntimeResources" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <ShaderSource Include="$(ProjectDir)src\Abstractions\Graphics\*.hlsl" />
    </ItemGroup>
    <Exec Command="xcopy /y /s /i /d &quot;$(ProjectDir)Resources&quot; &quot;$(OutDir)Resources&quot;" />
    <Copy SourceFiles="@(ShaderSource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
