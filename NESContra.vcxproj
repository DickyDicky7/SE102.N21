  <!-- Shaders are compiled by FXC as part of the build, so a syntax error is a
       build error rather than a black screen at runtime.  The .cso objects land
       next to the executable; GraphicsHelper loads those and only falls back to
       D3DCompileFromFile if they are missing.

       This group sits BEFORE the Microsoft.Cpp.targets import, where every other
       ItemGroup in this project lives.  MSBuild evaluates all items before it
       runs any target, so it worked after the import too - but keeping the
       declaration order conventional means the FXC item metadata is visible in
       the same place a reader expects to find ClCompile/ClInclude. -->
  <ItemGroup>
    <FxCompile Include="src\Abstractions\Graphics\SpriteVS.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>main</EntryPointName>
      <ObjectFileOutput>$(OutDir)%(Filename).cso</ObjectFileOutput>
      <HeaderFileOutput>
      </HeaderFileOutput>
    </FxCompile>
